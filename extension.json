{
  "name": "Antonio Extension",
  "id": "antonio-extension",
  "version": "1.0.0",
  "language": ["it"],
  "type": "torrent",
  "icon": "https://raw.githubusercontent.com/ChaldeaCenter/Miru-Extensions/main/icon.png",
  "nsfw": false,
  "search": "https://nyaa.si/?f=0&c=1_2&q={query}%201080p&sort=2",
  "scraper": {
    "item": {
      "selector": "tr.default, tr.success",
      "fields": {
        "title": {
          "selector": "td:nth-child(2) a:not(.comments)",
          "attribute": "text"
        },
        "link": {
          "selector": "td:nth-child(3) a[href$='.torrent']",
          "attribute": "href"
        },
        "size": {
          "selector": "td:nth-child(4)",
          "attribute": "text"
        },
        "seeders": {
          "selector": "td:nth-child(6)",
          "attribute": "text"
        },
        "leechers": {
          "selector": "td:nth-child(7)",
          "attribute": "text"
        }
      }
    }
  }
}
